# Copy to .env at repo root for docker-compose, or to apps/<service>/.env for local runs.

# --- Postgres ---
POSTGRES_USER=deximon
POSTGRES_PASSWORD=deximon
POSTGRES_DB=deximon
POSTGRES_HOST=postgres
POSTGRES_PORT=5433

# Full URL used by apps/api (SQLAlchemy)
DATABASE_URL=postgresql+psycopg://deximon:deximon@postgres:5432/deximon

# --- Redis (rate limiting and chat fanout) ---
REDIS_URL=redis://redis:6379/0

# --- apps/api ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000
SCANNER_URL=http://scanner:8001
SCANNER_TIMEOUT_SECONDS=90
# Global cost controls enforced transactionally by PostgreSQL.
DAILY_AWS_SCAN_LIMIT=10
MAX_USER_ACCOUNTS=100
# Per-client registration attempts allowed in one rolling Redis window.
REGISTER_RATE_LIMIT_REQUESTS=10
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret-before-running
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# Password reset email delivery. Keep EMAIL_MODE=console for local dev.
EMAIL_MODE=console
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Deximon
AUTH_COOKIE_SECURE=false
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- apps/scanner ---
SCANNER_HOST=0.0.0.0
SCANNER_PORT=8001
POKEMON_TCG_API_URL=https://api.pokemontcg.io/v2
POKEMON_TCG_API_KEY=
POKEMON_TCG_DATA_DIR=/data/pokemon-tcg-data
SCANNER_MOCK_DEFAULT_QUERY=Pikachu
SCANNER_OCR_MIN_CONFIDENCE=45
SCANNER_AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=deximon-uploads-dev

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SCANNER_URL=http://localhost:8001
API_URL=http://api:8000
