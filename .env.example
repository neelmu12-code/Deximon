# Copy to .env at repo root for docker-compose, or to apps/<service>/.env for local runs.

# --- Postgres ---
POSTGRES_USER=deximon
POSTGRES_PASSWORD=deximon
POSTGRES_DB=deximon
POSTGRES_HOST=postgres
POSTGRES_PORT=5433

# Full URL used by apps/api (SQLAlchemy)
DATABASE_URL=postgresql+psycopg://deximon:deximon@postgres:5432/deximon

# --- Redis (chat fanout, future) ---
REDIS_URL=redis://redis:6379/0

# --- apps/api ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8000
SCANNER_URL=http://scanner:8001
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret-before-running
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
AUTH_COOKIE_SECURE=false
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- apps/scanner ---
SCANNER_HOST=0.0.0.0
SCANNER_PORT=8001
POKEMON_TCG_API_URL=https://api.pokemontcg.io/v2
POKEMON_TCG_API_KEY=
SCANNER_MOCK_DEFAULT_QUERY=Pikachu
SCANNER_AWS_ENABLED=false
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=deximon-uploads-dev

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SCANNER_URL=http://localhost:8001
API_URL=http://api:8000
